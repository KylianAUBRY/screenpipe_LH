{
  "name": "NovaDesk — emails de bug vers tickets Jira",
  "nodes": [
    {
      "id": "0b5e6a52-4c1f-4f0e-9a37-2f7c1d9e0a01",
      "name": "Nouveaux emails",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2.1,
      "position": [0, 0],
      "parameters": {
        "postProcessAction": "read",
        "options": {
          "customEmailConfig": "[\"UNSEEN\"]"
        }
      },
      "notes": "Lit chaque nouvel email non lu de la boîte support, puis le marque comme lu pour ne jamais le traiter deux fois."
    },
    {
      "id": "0b5e6a52-4c1f-4f0e-9a37-2f7c1d9e0a02",
      "name": "Analyse de l'email",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2,
      "position": [260, 0],
      "parameters": {
        "promptType": "define",
        "text": "=Expéditeur : {{ $json.from }}\nObjet : {{ $json.subject }}\n\n{{ $json.textPlain }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "Tu tries les emails du support NovaDesk. Réponds type = Bug pour un défaut, Tâche pour une idée d'amélioration, none sinon. Cherche dans ScreenPipe comment l'agent a traité des emails similaires et reprends ses conventions de produit, de priorité et d'étiquette."
        }
      },
      "notes": "L'IA décide si l'email est un bug, une idée ou rien, et en extrait le produit, un résumé court, la priorité et l'étiquette back ou front."
    },
    {
      "id": "0b5e6a52-4c1f-4f0e-9a37-2f7c1d9e0a03",
      "name": "Modèle IA ScreenPipe",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [160, 220],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "options": {}
      },
      "notes": "Utilise le modèle IA de votre abonnement ScreenPipe, via le proxy local."
    },
    {
      "id": "0b5e6a52-4c1f-4f0e-9a37-2f7c1d9e0a04",
      "name": "Historique ScreenPipe",
      "type": "n8n-nodes-screenpipe.screenPipeTool",
      "typeVersion": 1,
      "position": [300, 220],
      "parameters": {
        "operation": "searchContent"
      },
      "notes": "Retrouve dans ScreenPipe comment vous avez traité des emails similaires, pour copier vos conventions."
    },
    {
      "id": "0b5e6a52-4c1f-4f0e-9a37-2f7c1d9e0a05",
      "name": "Format de sortie",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [440, 220],
      "parameters": {
        "jsonSchemaExample": "{\n  \"type\": \"Bug\",\n  \"product\": \"NovaCRM\",\n  \"summary\": \"Export CSV des contacts filtrés vide\",\n  \"priority\": \"Highest\",\n  \"label\": \"back\"\n}"
      },
      "notes": "Oblige l'IA à répondre dans un format fixe : type, produit, résumé, priorité et étiquette."
    },
    {
      "id": "0b5e6a52-4c1f-4f0e-9a37-2f7c1d9e0a06",
      "name": "Ticket à créer ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [560, 0],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1d9e0a0-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.output.type }}",
              "rightValue": "none",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "notes": "S'arrête ici quand l'email ne justifie aucun ticket, par exemple une alerte de sécurité."
    },
    {
      "id": "0b5e6a52-4c1f-4f0e-9a37-2f7c1d9e0a07",
      "name": "Préparer le ticket",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [800, -20],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1d9e0a0-0000-4000-8000-000000000002",
              "name": "title",
              "value": "={{ $json.output.product }} - {{ $json.output.summary }}",
              "type": "string"
            },
            {
              "id": "c1d9e0a0-0000-4000-8000-000000000003",
              "name": "description",
              "value": "={{ $('Nouveaux emails').item.json.textPlain.split('\\n').map(line => '> ' + line).join('\\n') }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "notes": "Construit sans IA le titre « Produit - résumé » et une description qui cite l'email d'origine."
    },
    {
      "id": "0b5e6a52-4c1f-4f0e-9a37-2f7c1d9e0a08",
      "name": "Créer le ticket Jira",
      "type": "n8n-nodes-base.jira",
      "typeVersion": 1,
      "position": [1040, -20],
      "parameters": {
        "project": {
          "__rl": true,
          "mode": "id",
          "value": "NOVA"
        },
        "issueType": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.output.type }}"
        },
        "summary": "={{ $json.title }}",
        "additionalFields": {
          "description": "={{ $json.description }}",
          "labels": "={{ [$json.output.label] }}",
          "priority": {
            "__rl": true,
            "mode": "id",
            "value": "={{ $json.output.priority }}"
          }
        }
      },
      "notes": "Crée le ticket dans le projet Jira NOVA, non assigné, avec le type, la priorité et l'étiquette choisis."
    },
    {
      "id": "0b5e6a52-4c1f-4f0e-9a37-2f7c1d9e0a09",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-40, -200],
      "parameters": {
        "content": "Provisional fixture. Ticket 01 replaces this file with the workflow exported from the demo n8n instance.",
        "height": 140,
        "width": 420
      }
    }
  ],
  "connections": {
    "Nouveaux emails": {
      "main": [[{ "node": "Analyse de l'email", "type": "main", "index": 0 }]]
    },
    "Modèle IA ScreenPipe": {
      "ai_languageModel": [[{ "node": "Analyse de l'email", "type": "ai_languageModel", "index": 0 }]]
    },
    "Historique ScreenPipe": {
      "ai_tool": [[{ "node": "Analyse de l'email", "type": "ai_tool", "index": 0 }]]
    },
    "Format de sortie": {
      "ai_outputParser": [[{ "node": "Analyse de l'email", "type": "ai_outputParser", "index": 0 }]]
    },
    "Analyse de l'email": {
      "main": [[{ "node": "Ticket à créer ?", "type": "main", "index": 0 }]]
    },
    "Ticket à créer ?": {
      "main": [[{ "node": "Préparer le ticket", "type": "main", "index": 0 }], []]
    },
    "Préparer le ticket": {
      "main": [[{ "node": "Créer le ticket Jira", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
